{
  "name": "@arandevcode/opencode-thinking",
  "version": "0.3.2",
  "description": "Theme-aware visual thinking indicators for opencode — rainbow border (warning/error), IDLE state in success color, and construction sidebar",
  "type": "module",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.tsx"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc && node scripts/postbuild.mjs",
    "prepublish": "tsc && node scripts/postbuild.mjs",
    "dev": "tsc --watch",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "keywords": [
    "opencode",
    "plugin",
    "thinking",
    "visualizer",
    "tui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "arandevcode",
  "license": "MIT",
  "oc-plugin": [
    "server",
    "tui"
  ],
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.16.0",
    "@opentui/core": ">=0.4.1 <1",
    "@opentui/solid": ">=0.4.1 <1",
    "solid-js": ">=1.8.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.16.0",
    "@opentui/core": "^0.5.1",
    "@opentui/keymap": "^0.5.1",
    "@opentui/solid": "^0.5.1",
    "@types/node": "^25.9.3",
    "solid-js": "^1.8.17",
    "typescript": "^5.4.0"
  },
  "files": [
    "dist",
    "images",
    "LICENSE",
    "src",
    "example.opencode.json",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arandevcode/opencode-plugins.git",
    "directory": "opencode-thinking"
  },
  "homepage": "https://github.com/arandevcode/opencode-plugins/tree/main/opencode-thinking#readme"
}
